# NIDO Supabase Environment Configuration (PLACEHOLDERS ONLY)
# Copy to .env.development (for nido-dev) or .env.production (for nido-prod).
# NEVER commit .env.development, .env.production, or any real keys to GitHub.
# NEVER put SUPABASE_SERVICE_ROLE_KEY in any VITE_* frontend variable.

# Development Project (nido-dev)
VITE_SUPABASE_URL=https://YOUR_NIDO_DEV_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_NIDO_DEV_ANON_KEY

# Production Project (nido-prod) — ONLY use in production deployment secrets
# VITE_SUPABASE_URL=https://YOUR_NIDO_PROD_PROJECT_REF.supabase.co
# VITE_SUPABASE_ANON_KEY=YOUR_NIDO_PROD_ANON_KEY
